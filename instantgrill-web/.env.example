# Admin dashboard at /admin. Off until set. Use 16+ random characters:
#   openssl rand -hex 24
ADMIN_TOKEN=

# Postgres for orders (recommended in production). Run db/schema.sql first.
# Leave empty to store orders in a JSON file under DATA_DIR (single server only).
DATABASE_URL=
DATA_DIR=./data

# Optional: every new order is POSTed here as {"event":"order.created","order":{...}}.
# Point it at a Google Apps Script, Slack/Zapier hook, or your WhatsApp agent.
ORDER_WEBHOOK_URL=
# Sent as the x-webhook-secret header so the receiver can verify the sender.
ORDER_WEBHOOK_SECRET=
