# ---------- Owner admin (/admin) ----------
# Admin stays switched off until all three are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=            # 12+ characters
ADMIN_SESSION_SECRET=      # 32+ random characters: openssl rand -hex 32

# ---------- Database ----------
# Supabase: Project Settings > Database > Connection string (URI, "Transaction pooler").
# Run db/migrations/001_init.sql in the Supabase SQL editor first.
# Empty = JSON files under DATA_DIR (local development, single server only).
DATABASE_URL=
DATA_DIR=./data

# ---------- Owner alerts ----------
# Email on every order, enquiry and contact message (https://resend.com, verify instantgrill.shop).
RESEND_API_KEY=
OWNER_EMAIL=
RESEND_FROM="Instant Grill <orders@instantgrill.shop>"
# Optional: every event is also POSTed as JSON here (Google Sheet script, Zapier, WhatsApp agent).
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=

# ---------- Tracking ----------
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=           # Events Manager > Settings > Conversions API > Generate access token
META_CAPI_TEST_CODE=       # optional, for the Test Events tab
NEXT_PUBLIC_GA4_ID=        # G-XXXXXXXXXX
