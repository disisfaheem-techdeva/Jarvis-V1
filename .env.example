# app connects as the NON-superuser role so RLS is enforced
DATABASE_URL=postgresql://techdeva_app:techdeva@db:5432/techdeva
REDIS_URL=redis://redis:6379/0

# --- Live Hermes bot (Agent 07) ---
# Leave HERMES_URL unset for the dev stub. Set it to your bot's base URL to go live.
# HERMES_URL=http://your-vps-or-desktop:8090
# HERMES_REPLY_PATH=/reply
# HERMES_API_KEY=change-me
# HERMES_TIMEOUT=8
# HERMES_RETRIES=2

# --- OAuth (client account connections) ---
# Register a Meta App at developers.facebook.com → Settings → Basic
# META_APP_ID=your-app-id
# META_APP_SECRET=your-app-secret

# Register an OAuth client at console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_SECRET=your-secret

# Public base URL of this API (used as the OAuth redirect origin)
# OAUTH_REDIRECT_BASE=https://api.techdeva.net

# --- Autopilot Gallery (docs/AUTOPILOT-GALLERY.md) ---
# Where uploaded marketing media is kept: local (MEDIA_DIR/gallery, served at /media/g/) or s3
# STORAGE_BACKEND=local
# MEDIA_DIR=/srv/media
# For STORAGE_BACKEND=s3 (any S3-compatible bucket; tenants/* must be publicly readable):
# S3_BUCKET=
# S3_PUBLIC_BASE=https://media.example.com
# S3_ENDPOINT=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Vision (what is in each picture): unset = stub; gemini or anthropic = live
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-2.5-flash
# Captions: auto (live when an AI key is set), live, or stub
# CAPTION_MODE=auto
# Publishing: live when META_APP_ID is set, else stub; force with stub|live
# META_PUBLISH_MODE=
# META_GRAPH_VERSION=v21.0
# IG_POLL_IMAGE_S=60
# IG_POLL_VIDEO_S=600
# Google Business Profile: stub only, off by default
# GBP_PUBLISH_ENABLED=false
